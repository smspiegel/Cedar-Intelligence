{
  "name": "project-cedar-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "workflow": "node dist/workflow.js",
    "workflow:dev": "render workflows dev -- tsx src/workflow.ts",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@renderinc/sdk": "^1.0.0",
    "@surrealdb/memory": "latest",
    "dotenv": "latest",
    "fastify": "latest",
    "jose": "^6.2.13",
    "surrealdb": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
