NODE_ENV=development
PORT=3000
API_TOKEN=replace-with-a-long-development-token
TENANT_ID=demo-org

SURREAL_URL=ws://127.0.0.1:8000/rpc
SURREAL_NAMESPACE=cedar
SURREAL_DATABASE=cedar
SURREAL_USERNAME=root
SURREAL_PASSWORD=root

# Render Workflows. RENDER_API_KEY is unnecessary when RENDER_USE_LOCAL_DEV=true.
RENDER_WORKFLOW_SLUG=cedar-workflow
RENDER_API_KEY=
RENDER_USE_LOCAL_DEV=true
# RENDER_LOCAL_DEV_URL=http://localhost:8120

# OpenAI-compatible Chat Completions endpoint that supports JSON mode.
EVALUATOR_URL=https://api.openai.com/v1/chat/completions
EVALUATOR_API_KEY=
EVALUATOR_MODEL=gpt-5-mini

# All three values are required to enable Agent Memory. Leave all blank for seeded fallback.
AGENT_MEMORY_ENDPOINT=
AGENT_MEMORY_CONTEXT=
AGENT_MEMORY_API_KEY=
SEEDED_CONTEXT=Project Cedar seeded development context.

