NODE_ENV=development
PORT=3000

# PostHog product analytics, error tracking, and logs are exported only when
# NODE_ENV=production. These variables are configured on the production services.
POSTHOG_API_KEY=phc_your_posthog_project_token
POSTHOG_HOST=https://your-posthog-host
# Development mode accepts this token and uses the configured TENANT_ID. Never expose
# this token in a production Expo build.
AUTH_MODE=development
API_TOKEN=replace-with-a-long-development-token
TENANT_ID=demo-org
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Production mode validates user JWTs. The tenant is read from AUTH_TENANT_CLAIM.
# AUTH_MODE=jwt
# AUTH_ISSUER=https://your-identity-provider.example
# AUTH_AUDIENCE=cedar-api
# AUTH_JWKS_URL=https://your-identity-provider.example/.well-known/jwks.json
AUTH_TENANT_CLAIM=org_id

SURREAL_URL=ws://127.0.0.1:8000/rpc
SURREAL_NAMESPACE=cedar
SURREAL_DATABASE=cedar
SURREAL_USERNAME=root
SURREAL_PASSWORD=root

# SurrealDB Agent Memory. Start in shadow mode to write and recall memory without
# adding recalled context to evaluator prompts; move to assist after reviewing traces.
AGENT_MEMORY_MODE=off
AGENT_MEMORY_ENDPOINT=
AGENT_MEMORY_CONTEXT=
AGENT_MEMORY_API_KEY=
# Optional prefix for delegated tenant principals, e.g. cedar/
AGENT_MEMORY_PRINCIPAL_PREFIX=

# Render Workflows. RENDER_API_KEY is unnecessary when RENDER_USE_LOCAL_DEV=true.
RENDER_WORKFLOW_SLUG=cedar-workflow
RENDER_API_KEY=
RENDER_USE_LOCAL_DEV=true
# RENDER_LOCAL_DEV_URL=http://localhost:8120

# OpenAI-compatible Chat Completions endpoint that supports JSON mode.
EVALUATOR_URL=https://api.openai.com/v1/chat/completions
EVALUATOR_API_KEY=
EVALUATOR_MODEL=gpt-5-mini

# Exa's standard Search API. Results are capped per query before URL deduplication.
EXA_API_URL=https://api.exa.ai/search
EXA_API_KEY=
EXA_RESULTS_PER_QUERY=10
