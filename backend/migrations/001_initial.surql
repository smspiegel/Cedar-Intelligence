DEFINE TABLE IF NOT EXISTS organization SCHEMALESS;
DEFINE INDEX IF NOT EXISTS organization_key ON TABLE organization FIELDS key
  UNIQUE;
DEFINE TABLE IF NOT EXISTS monitor SCHEMALESS;
DEFINE INDEX IF NOT EXISTS monitor_key ON TABLE monitor FIELDS key UNIQUE;
DEFINE INDEX IF NOT EXISTS monitor_tenant ON TABLE monitor FIELDS tenantId;
DEFINE TABLE IF NOT EXISTS execution SCHEMALESS;
DEFINE INDEX IF NOT EXISTS execution_key ON TABLE execution FIELDS key UNIQUE;
DEFINE INDEX IF NOT EXISTS execution_tenant ON TABLE execution FIELDS tenantId;
DEFINE TABLE IF NOT EXISTS observation SCHEMALESS;
DEFINE INDEX IF NOT EXISTS observation_key ON TABLE observation FIELDS key
  UNIQUE;
DEFINE TABLE IF NOT EXISTS evaluation SCHEMALESS;
DEFINE INDEX IF NOT EXISTS evaluation_key ON TABLE evaluation FIELDS key UNIQUE;
DEFINE TABLE IF NOT EXISTS finding SCHEMALESS;
DEFINE INDEX IF NOT EXISTS finding_key ON TABLE finding FIELDS key UNIQUE;
DEFINE INDEX IF NOT EXISTS finding_tenant ON TABLE finding FIELDS tenantId;
