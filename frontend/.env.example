# Public values are embedded in the Expo bundle. Never put credentials here.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Local development only. When present in a development build, this is used for API
# requests even if Clerk is enabled for the frontend UI. Production uses Clerk JWTs.
EXPO_PUBLIC_DEV_API_TOKEN=replace-with-your-local-api-token
